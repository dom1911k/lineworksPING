<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textAppearance="?attr/textAppearanceHeadlineSmall"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/app_tagline"
            android:textAppearance="?attr/textAppearanceBodyMedium" />

        <!-- Master + quick tile -->
        <com.google.android.material.card.MaterialCardView style="@style/Card">

            <LinearLayout style="@style/CardBody">

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switchEnabled"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/enable_app"
                    android:textAppearance="?attr/textAppearanceTitleMedium" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/tile_hint"
                    android:textAppearance="?attr/textAppearanceBodySmall"
                    android:textColor="?android:attr/textColorSecondary" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAddTile"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/add_tile" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Setup status dashboard -->
        <com.google.android.material.card.MaterialCardView style="@style/Card">

            <LinearLayout style="@style/CardBody">

                <TextView
                    style="@style/CardTitle"
                    android:text="@string/status_title" />

                <TextView
                    android:id="@+id/statusSummary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textAppearance="?attr/textAppearanceTitleSmall"
                    tools:text="2 things need your attention" />

                <LinearLayout
                    android:id="@+id/statusContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:orientation="vertical" />

                <TextView
                    android:id="@+id/textHealth"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:textAppearance="?attr/textAppearanceBodySmall"
                    android:textColor="?android:attr/textColorSecondary"
                    tools:text="Listener: connected — last message 2 min ago" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Apps to watch -->
        <com.google.android.material.card.MaterialCardView style="@style/Card">

            <LinearLayout style="@style/CardBody">

                <TextView
                    style="@style/CardTitle"
                    android:text="@string/section_apps" />

                <TextView
                    android:id="@+id/textApps"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    tools:text="0 apps monitored" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPickApps"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/choose_apps" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- What triggers a ping -->
        <com.google.android.material.card.MaterialCardView style="@style/Card">

            <LinearLayout style="@style/CardBody">

                <TextView
                    style="@style/CardTitle"
                    android:text="@string/section_rules" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switchDm"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/rule_dm" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switchMention"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/rule_mention" />

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:hint="@string/hint_keywords"
                    app:helperText="@string/help_keywords"
                    app:helperTextEnabled="true">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/editKeywords"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textMultiLine|textNoSuggestions"
                        android:minLines="1" />

                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switchRequireAt"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/rule_require_at" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switchLogAll"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/rule_log_all" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Alert style -->
        <com.google.android.material.card.MaterialCardView style="@style/Card">

            <LinearLayout style="@style/CardBody">

                <TextView
                    style="@style/CardTitle"
                    android:text="@string/section_sound" />

                <TextView
                    android:id="@+id/textSound"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    tools:text="Sound: Default" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnPickSound"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/choose_sound" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnTestSound"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="@string/test_ping" />

                </LinearLayout>

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switchReadAloud"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/rule_read_aloud" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="8dp"
                    android:background="?android:attr/listDivider" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switchFullScreen"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/rule_fullscreen" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/alert_color_label"
                    android:textAppearance="?attr/textAppearanceBodyMedium" />

                <Spinner
                    android:id="@+id/spinnerColor"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/alert_speed_label"
                    android:textAppearance="?attr/textAppearanceBodyMedium" />

                <Spinner
                    android:id="@+id/spinnerSpeed"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/alert_textsize_label"
                    android:textAppearance="?attr/textAppearanceBodyMedium" />

                <Spinner
                    android:id="@+id/spinnerTextSize"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switchAlertVibrate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/alert_vibrate" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switchAlertPulse"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/alert_pulse" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPreviewAlert"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/preview_alert" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Do Not Disturb -->
        <com.google.android.material.card.MaterialCardView style="@style/Card">

            <LinearLayout style="@style/CardBody">

                <TextView
                    style="@style/CardTitle"
                    android:text="@string/section_dnd" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switchBypassDnd"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/rule_bypass_dnd" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Auto-silence -->
        <com.google.android.material.card.MaterialCardView style="@style/Card">

            <LinearLayout style="@style/CardBody">

                <TextView
                    style="@style/CardTitle"
                    android:text="@string/section_silence" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switchSilenceCharging"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/rule_silence_charging" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switchOfficeWifi"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/rule_office_wifi" />

                <TextView
                    android:id="@+id/textWifiStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textAppearance="?attr/textAppearanceBodySmall"
                    android:textColor="?android:attr/textColorSecondary"
                    tools:text="Currently connected to: OfficeNet" />

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:hint="@string/hint_ssids"
                    app:helperText="@string/help_ssids"
                    app:helperTextEnabled="true">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/editOfficeSsids"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textMultiLine|textNoSuggestions"
                        android:minLines="1" />

                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnUseWifi"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/use_wifi" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Activity & updates -->
        <com.google.android.material.card.MaterialCardView style="@style/Card">

            <LinearLayout style="@style/CardBody">

                <TextView
                    style="@style/CardTitle"
                    android:text="@string/section_activity" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnRecent"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/recent_activity" />

                <TextView
                    android:id="@+id/textVersion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    tools:text="Installed version: 1.0" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCheckUpdate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/check_updates" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <Space
            android:layout_width="match_parent"
            android:layout_height="16dp" />

    </LinearLayout>

</ScrollView>
